# Server Configuration
PORT=4000
NODE_ENV=development

# Database
# For local development or MongoDB Atlas:
# e.g. mongodb://127.0.0.1:27017/date_crew_db or mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/date_crew_db

# Security & Authentication
# Replace with a high-entropy secret string in production:
JWT_SECRET=super_secret_jwt_key_replace_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins, e.g. https://your-app.vercel.app,http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Email & Delivery Configuration
# In demo mode, leave EMAIL_MOCK_MODE=true to simulate delivery without sending real customer emails
EMAIL_MOCK_MODE=true
DELIVERY_ADAPTER=mock

# OpenAI Integration (Personalized match introductions via Responses API)
# Supply your API key; if left blank or failed, the application automatically uses high-quality matrimonial fallback introductions.
OPENAI_API_KEY=
# Supported OpenAI model (e.g., gpt-4o-mini, gpt-4o). Defaults to gpt-4o-mini if not specified.
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

